---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL for og:image. Defaults to the FedEthics mark. */
  ogImage?: string;
  /** Set true for reader-only pages that must stay out of search results. */
  noindex?: boolean;
  /** Which nav item to mark active. Omit on pages with no nav match. */
  active?: string;
  /** GA event name used by track(). book.html historically reports downloads. */
  trackEvent?: string;
  /** GA event_category used by track(). */
  trackCategory?: string;
}

const {
  title,
  description = 'FedEthics Inc. — AI governance advisory, ethical leadership frameworks, and two books by Celio Oliveira. Global Top 100 AI Innovator.',
  ogImage = '/images/FedEthics.png',
  noindex = false,
  trackEvent = 'click',
  trackCategory = 'CTA',
} = Astro.props;

// Single source of truth for analytics IDs (previously split across two GTM containers).
const GTM_ID = 'GTM-5CTTT33C';
const GA_ID = 'G-2F5300W8X0';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/images/FedEthics.png" />

    <!-- Consent defaults. MUST run synchronously before GTM/GA so no analytics
         or advertising cookies are set until the visitor opts in. -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = window.gtag || gtag;

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });

        try {
          if (localStorage.getItem('fe-cookie-consent') === 'granted') {
            gtag('consent', 'update', {
              ad_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              analytics_storage: 'granted'
            });
          }
        } catch (e) { /* localStorage unavailable — stay denied */ }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FedEthics Inc." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM_ID }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',GTM_ID);
    </script>

    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID, trackEvent, trackCategory }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA_ID);
      // Global CTA tracker used by inline on* handlers across the site.
      window.track = function (label) {
        gtag('event', trackEvent, { event_category: trackCategory, event_label: label });
      };
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript is:inline set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
